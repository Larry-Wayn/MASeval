# DeepSeek API 配置
# 复制本文件为 .env 并填入真实值；.env 不要提交到版本控制
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 模型选项（DeepSeek V4，2026-04 后的新命名）：
#   deepseek-v4-flash : 284B MoE / 128K 上下文，便宜快，本项目默认
#   deepseek-v4-pro   : 1.6T MoE / 1M 上下文，更强但更贵
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.7

# MAS 系统配置（可选）
MAS_NUM_AGENTS=3
MAS_MAX_ROUNDS=5
MAS_ENABLE_VALIDATION=true

# 并发与重试（用于 run_ablation.py / experiments.py 长跑实验）
# max_workers 调高可加速但有 API 限流风险，付费账号建议 8~16
MAS_MAX_WORKERS=8
MAS_MAX_RETRIES=3
MAS_RETRY_BASE_DELAY=2.0
